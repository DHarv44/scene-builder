{
  "name": "low-sun-scene-builder",
  "version": "0.1.0",
  "description": "Visual timeline editor for Low Sun cutscenes",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 node scripts/run-electron.cjs\"",
    "vite:dev": "vite",
    "vite:build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "keywords": [
    "low-sun",
    "scene-editor",
    "timeline",
    "electron"
  ],
  "author": "Low Sun Team",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.lowsun.scenebuilder",
    "productName": "Low Sun Scene Builder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "main.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
